# Hugging Face Access Token (Required to download SAM 3 model weights)
# Request access at: https://huggingface.co/facebook/sam3
# Create token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Local Model Checkpoint Configuration
SAM3_CHECKPOINT_PATH=e:/AI/Segmentation_model_by_meta/models/sam3/sam3.pt

# Target Execution Device ("cpu" or "cuda")
SAM3_DEVICE=cpu
